{% extends 'base.html.twig' %}

{% block title %}Sign In - Slim App{% endblock %}

{% block content %}
    <login-form action="/auth/login" target="#error-message"></login-form>

    <!-- Define the web component template here to keep the JS clean -->
    <template id="login-form-template">
        <div class="form-container">
            <h2>Sign In</h2>
            <form>
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>

                <label for="password">Password</label>
                <input type="password" id="password" name="password" required>

                <button type="submit">Log In</button>
            </form>
            <div id="error-message"></div>
        </div>
        <div class="oauth-providers">
          <!-- Use a standard anchor link so the browser can navigate away -->
          <a href="/auth/login/github" class="btn btn-github">
            Sign in with GitHub
          </a>
        </div>
    </template>



    <!-- Include the component script -->
    <script src="/js/components/login-form.js" defer></script>
{% endblock %}
